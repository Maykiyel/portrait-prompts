{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./web/src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["*.ts", "server/**/*.ts", "shared/**/*.ts"]
}
