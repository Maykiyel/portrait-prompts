# Optional. Any private text. Makes your prompts differ from other users of this repo.
# Set it before your first run and never change it. Keep a copy somewhere safe.
SEED_SALT=

# Only needed for the paid API route (the Generate page and the generate script).
# Set the one for the provider you want to use. Both are read at start; a key you
# leave empty just means that provider cannot run.
# Gemini's image models have no free tier.
GEMINI_API_KEY=
# OpenAI needs a card with at least $5 on it, and may ask you to verify your org.
OPENAI_API_KEY=

# Optional. Port for the app. Default 3001.
# PORT=3001
